{
  "_doc": "Cross-harness verdict corpus for permission_matrix.py. 'claude' is the rules-only verdict (Claude's built-in read-only analyzer is not modeled); 'claude' also applies to claude-work. Read by test/test_gen_permissions.py and pi/test/permission-gate.test.ts.",
  "cases": [
    {
      "command": "git status",
      "claude": "allow",
      "opencode": "allow",
      "pi": "allow"
    },
    {
      "command": "git status && git diff",
      "claude": "allow",
      "opencode": "allow",
      "pi": "allow"
    },
    {
      "command": "git diff --stat",
      "claude": "allow",
      "opencode": "allow",
      "pi": "allow",
      "note": "plain diff stays allowed; only difftool is fenced"
    },
    {
      "command": "git difftool -y -x touch --no-index a b",
      "claude": "ask",
      "opencode": "ask",
      "pi": "ask",
      "note": "difftool -x/--extcmd runs the supplied command"
    },
    {
      "command": "git -C src difftool -y -x touch --no-index a b",
      "claude": "ask",
      "opencode": "ask",
      "pi": "ask"
    },
    {
      "command": "sort -o README.md STYLE.md",
