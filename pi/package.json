{
  "name": "atk-pi-extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --import ./test/helpers/sanitize-test-env.mjs --test --test-concurrency=1 --test-timeout=5000 test/*.test.ts",
    "test:clean": "env -u PI_AGENT_UNATTENDED npm test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint extensions test",
    "format": "prettier --write extensions test",
    "format:check": "prettier --check extensions test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.19.0",
    "esbuild": "0.25.12",
    "expect": "^30.5.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
