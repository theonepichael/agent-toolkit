[Unit]
Description=herdr remote-control bridge (HTTP+SSE in front of the herdr socket)
# The tailnet presence comes from the Windows host (WSL2), so there is no
# tailscaled unit to order against on this side; the bridge's own bounded
# bind retry covers the interface coming up.
After=network-online.target

[Service]
# Template: never copy this file as-is. install_unit.py renders the toolkit
# checkout path into the two lines below and installs the result (deploy.sh
# runs it on every deploy), so the checkout can live anywhere.
# [tool.uv] package = false, so python -m herdr_remote only resolves with
# the process cwd at the repo root; uv run --project does not cd there.
WorkingDirectory=@AGENT_TOOLKIT_CHECKOUT@
ExecStart=%h/.local/bin/uv run --project @AGENT_TOOLKIT_CHECKOUT@ python -m herdr_remote serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
