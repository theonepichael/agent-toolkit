{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "python3 ~/.claude/scripts/dev_status.py *": "allow",
      "python3 ~/.claude/scripts/grill.py *": "allow",
      "python3 ~/.claude/scripts/second_opinion.py *": "allow",
      "python3 ~/.claude/scripts/settings_seed_drift_check.py *": "allow",
      "python3 ~/.claude/scripts/bundle_drift_check.py *": "allow",
      "python3 ~/.claude/scripts/vitals_promotion.py *": "allow",
      "python3 agent-scripts/vitals_promotion.py *": "allow",
      "DEVSTATUS_AGENT=1 python3 *": "allow",
      "env DEVSTATUS_AGENT=1 python3 *": "allow",
      "npm install*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run format*": "allow",
      "./scripts/bootstrap-worktree.sh*": "allow",
      "scripts/bootstrap-worktree.sh*": "allow",
      "./scripts/build-copilot-swarm.sh*": "allow",
      "scripts/build-copilot-swarm.sh*": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git add*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git worktree*": "allow",
      "git rev-parse*": "allow",
      "git -C * log*": "allow",
      "git -C * status*": "allow",
      "git -C * diff*": "allow",
      "git -C * show*": "allow",
      "git -C * ls-files*": "allow",
      "git -C * check-ignore*": "allow",
      "git -C * add*": "allow",
      "git -C * branch*": "allow",
      "git -C * checkout*": "allow",
      "git -C * worktree*": "allow",
      "git -C * rev-parse*": "allow",
      "git commit*": "ask",
      "git -C * commit*": "ask",
      "uv sync*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff check*": "allow",
      "uv run ruff format*": "allow",
      "lsof *": "allow",
      "ps *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "env": "allow",
      "printenv*": "allow",
      "cat *": "allow",
      "sed -n *": "allow",
      "strings *": "allow",
      "readlink *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "diff": "allow",
      "echo *": "allow",
      "echo": "allow",
      "head": "allow",
      "tail": "allow",
      "wc": "allow",
      "sort": "allow",
      "uniq": "allow",
      "cat": "allow",
      "pgrep *": "allow",
      "ss *": "allow",
      "systemctl status*": "allow",
      "systemctl is-active*": "allow",
      "systemctl is-enabled*": "allow"
    },
    "external_directory": {
      "~/.claude/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/dotfiles/**": "allow",
      "~/dotfiles-*/**": "allow",
      "~/Workspace/**": "allow",
      "~/workspace/**": "allow",
      "/tmp/**": "allow",
      "/mnt/c/Users/yanil/Downloads/**": "allow",
      "/mnt/c/Users/yanil/OneDrive/Pictures/Screenshots/**": "allow"
    }
  },
  "agent": {
    "adversary": {
      "description": "Adversarial critique agent for grill-me's --auto mode and second_opinion.py's opencode backend. Argues against a proposed decision/plan using a model different from the primary session's default, so the critique is genuinely independent rather than the same model second-guessing itself. mode \"all\" (not \"subagent\") is required: opencode run --agent silently falls back to the default agent for anything marked subagent-only. Text-only by construction: every tool is denied here so a swapped-in model cannot take shell/file actions instead of returning a stateless critique.",
      "mode": "all",
      "model": "opencode-go/deepseek-v4-flash",
      "permission": "deny",
      "prompt": "You are a text-only adversarial reviewer. No tools are available: every tool call is denied, so never attempt one. Never emit tool-call markup of any kind — XML like <tool_calls> or <invoke name=...>, JSON tool-call blocks, or fenced tool invocations. Respond in plain prose only; if a tool would have helped, say in the critique what you were unable to check."
    },
    "grounded_adversary": {
      "description": "Grounded adversarial critique agent for second_opinion.py's opencode backend. Read-only codebase exploration allowed; write, edit, bash, and task tools denied.",
      "mode": "all",
      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": false,
        "edit": false,
        "bash": false,
        "task": false,
        "todowrite": false,
        "webfetch": false,
        "websearch": false,
        "skill": false
      },
      "prompt": "You are an adversarial reviewer evaluating an implementation plan against a real codebase. Use read-only inspection tools (read, grep, glob) to examine existing code, interfaces, tests, and call sites. You cannot modify files or execute bash commands. Respond with a rigorous critique grounded in what the code actually does."
    }
  }
}
