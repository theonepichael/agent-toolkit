{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "type": "command", "bash": "python3 ~/.claude/scripts/dev_status.py render 2>&1", "timeoutSec": 10 },
      { "type": "command", "bash": "python3 ~/.claude/scripts/grill.py pending-plan --consume 2>/dev/null; true", "timeoutSec": 10 },
      { "type": "command", "bash": "python3 ~/.claude/scripts/dotfiles_sync_check.py 2>/dev/null", "timeoutSec": 10 },
      { "type": "command", "bash": "python3 ~/.claude/scripts/settings_seed_drift_check.py 2>/dev/null", "timeoutSec": 10 }
    ]
  }
}
